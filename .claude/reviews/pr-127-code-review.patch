+  # Order sheets locale-independently (radix = C locale) to honor the
+  # pipeline's determinism contract; a bare sort() follows the session
+  # LC_COLLATE and can reorder sheets across machines.
+  detected_tables <- detected_tables[
+    sort(names(detected_tables), method = "radix")
+  ]
 
   detected_tables <- detected_tables[
     !grepl("_post_processed$", names(detected_tables))
   ]
 
-  ordered_names <- sort(names(detected_tables))
+  ordered_names <- sort(names(detected_tables), method = "radix")
   detected_tables <- detected_tables[ordered_names]
 
   return(purrr::map(detected_tables, data.table::as.data.table))
