diff --git a/r/1-import_pipeline/12-transform/12-processing.R b/r/1-import_pipeline/12-transform/12-processing.R
index 35326ee..d1d093a 100644
--- a/r/1-import_pipeline/12-transform/12-processing.R
+++ b/r/1-import_pipeline/12-transform/12-processing.R
@@ -212,14 +212,28 @@ read_transform_pipeline_files <- function(
 
   # Each batch carries its own metadata rows so workers receive only small
   # objects; batch order and within-batch file order preserve the global file
-  # order, keeping the combined output identical to the two-stage path.
-  batch_objects <- lapply(workbook_batches, function(batch_paths) {
-    batch_indices <- match(batch_paths, file_paths)
-    list(
-      paths = batch_paths,
-      file_rows = lapply(batch_indices, function(i) file_list_dt[i])
-    )
-  })
+  # order, keeping the combined output identical to the two-stage path. Pair
+  # each file with its metadata by position, not by `match()` on the path
+  # value: `match(batch_paths, file_paths)` returns the first index for a
+  # repeated path, so a file_list_dt that ever maps one workbook path to two
+  # distinct metadata rows would transform the duplicate with the wrong row.
+  # Batches are contiguous slices of file_paths in order, so positional row
+  # indices recover each row's own metadata and stay identical to the
+  # per-row `file_list_dt[i]` pairing of the old two-stage path.
+  batch_row_indices <- split(
+    seq_along(file_paths),
+    rep(seq_along(workbook_batches), lengths(workbook_batches))
+  )
+  batch_objects <- Map(
+    function(batch_paths, batch_indices) {
+      list(
+        paths = batch_paths,
+        file_rows = lapply(batch_indices, function(i) file_list_dt[i])
+      )
+    },
+    workbook_batches,
+    batch_row_indices
+  )
 
   use_parallel <- !inherits(future::plan(), "sequential") &&
     length(batch_objects) > 1L
